{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Auth:ApiKey y las credenciales reales de IceServers NO van aca (este
  // archivo se trackea en git). Van en appsettings.Production.json, que
  // esta en .gitignore - ver appsettings.Production.json.example para la
  // plantilla, y DECISIONES.md D19 para el porque. En Production, ASP.NET
  // Core carga este archivo primero y appsettings.Production.json despues,
  // pisando estos valores vacios con los reales.
  "Auth": {
    "ApiKey": ""
  },
  // [FIX LATENCIA] Antes esto apuntaba a dos IPs fijas de un TURN en Francia
  // (62.210.205.50 / 51.158.147.206). Si casa y viewer estan lejos de Francia,
  // TODO el video relayado da una vuelta innecesaria por ahi, sumando latencia
  // y aumentando el riesgo de que la negociacion ICE no cierre a tiempo. Se
  // alinea con el mismo dominio que ya usaba el Gateway (free.expressturn.com)
  // en vez de IPs fijas de un solo datacenter.
  //
  // OJO: el tier free de ExpressTurn es un unico datacenter (no anycast
  // geo-distribuido), asi que esto por si solo NO resuelve el problema de
  // fondo si las casas/viewers estan lejos de esa region. La solucion real
  // es: (a) contratar un TURN con puntos de presencia en la region donde
  // estan las casas/viewers (ej. Twilio, Xirsys, Metered con anycast), o
  // (b) levantar un coturn propio en un VPS cerca de los usuarios reales
  // (ej. Sudamerica) y listarlo ACA antes que el de expressturn, para que
  // ICE priorice el de menor RTT. (Evaluado y pausado por ahora - ver
  // DECISIONES.md D19/discusion de TURN georreferenciado: Pi descartado
  // por CGNAT, VPS propio o Premium de ExpressTurn quedan como opciones
  // futuras.)
  //
  // Username/Credential reales van en appsettings.Production.json
  // (gitignored) - el .NET config los pisa por indice de array.
  "IceServers": [
    {
      "Urls": "turn:free.expressturn.com:3478",
      "Username": "",
      "Credential": ""
    },
    {
      "Urls": "stun:stun.l.google.com:19302"
    }
  ]
}
