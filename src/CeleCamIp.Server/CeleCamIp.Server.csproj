<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>240871b6-4899-4025-baed-b0b24916c98f</UserSecretsId>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
  </ItemGroup>

  <!--
    EnvironmentName=Production hace que el SDK incruste ASPNETCORE_ENVIRONMENT=Production
    en el web.config generado al publicar (este hosting compartido no tiene panel de
    variables de entorno). Con esto el viewer de prueba (wwwroot/index.html) NO se sirve
    en el sitio publico (ver Program.cs). La API key en si va en appsettings.Production.json
    (no en el csproj), porque el mecanismo de variables por web.config trunca valores que
    terminan en "=" como el padding de base64.
  -->

  <ItemGroup>
    <ProjectReference Include="..\CeleCamIp.Shared\CeleCamIp.Shared.csproj" />
  </ItemGroup>

</Project>