# ---- Etapa de build ----
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copiamos solo los .csproj primero para aprovechar el cache de Docker
# (si no cambiaron las dependencias, no vuelve a hacer restore).
COPY ["CeleCamIp.Gateway/CeleCamIp.Gateway.csproj", "CeleCamIp.Gateway/"]
COPY ["CeleCamIp.Shared/CeleCamIp.Shared.csproj", "CeleCamIp.Shared/"]
RUN dotnet restore "CeleCamIp.Gateway/CeleCamIp.Gateway.csproj"

COPY CeleCamIp.Gateway/ CeleCamIp.Gateway/
COPY CeleCamIp.Shared/ CeleCamIp.Shared/

RUN dotnet publish "CeleCamIp.Gateway/CeleCamIp.Gateway.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore

# ---- Etapa final (runtime) ----
FROM mcr.microsoft.com/dotnet/runtime:9.0
WORKDIR /app

# ffmpeg: las librerias nativas que SIPSorceryMedia.FFmpeg necesita para
# poder leer el RTSP de las camaras y codificar el video para WebRTC.
# Sin esto, FFmpegInit.EnsureBinariesRegistered() falla en tiempo de ejecucion.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "CeleCamIp.Gateway.dll"]