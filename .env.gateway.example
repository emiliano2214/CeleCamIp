# Copiar este archivo como ".env" (sin ".example") junto al docker-compose.gateway.yml,
# y completar con los valores reales. El .env real NO se sube a git.

# URL del hub del Server. En produccion, la URL real de MonsterASP (https).
SERVER_HUB_URL=https://camarasip.runasp.net/hubs/gateway

# Identificador de esta casa (debe ser unico si hay mas de un Gateway)
HOUSE_ID=casa-dev-01

# IPs de las 4 camaras de esta casa
CAMERA_IP_1=192.168.0.25
CAMERA_IP_2=192.168.0.26
CAMERA_IP_3=192.168.0.27
CAMERA_IP_4=192.168.0.29
CAMERA_USERNAME=admin
CAMERA_PASSWORD=admin

# Credenciales de ExpressTURN (dashboard de expressturn.com)
TURN_USERNAME=000000002103979882
TURN_CREDENTIAL=

# Clave compartida para autenticarse contra el Hub (debe coincidir con Auth:ApiKey del Server)
AUTH_API_KEY=
